# {{ ansible_managed }}
[Unit]
Description=Dummy Fluent Bit HTTP log receiver (test only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ fb_receiver_user }}
Group={{ fb_receiver_group }}
EnvironmentFile={{ fb_receiver_conf_dir }}/receiver.env
ExecStart={{ fb_receiver_python }} -u {{ fb_receiver_install_dir }}/receiver.py
Restart=on-failure
RestartSec=5
UMask=0027

# Hardening: read-only system, writable log dir only
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths={{ fb_receiver_log_dir }}
{% if fb_receiver_port | int < 1024 %}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
{% else %}
CapabilityBoundingSet=
{% endif %}

[Install]
WantedBy=multi-user.target
