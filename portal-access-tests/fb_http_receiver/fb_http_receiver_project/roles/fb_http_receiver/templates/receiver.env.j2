# {{ ansible_managed }}
BIND={{ fb_receiver_bind_address }}
PORT={{ fb_receiver_port }}
URI_PATHS={{ fb_receiver_uri_paths | join(',') }}
LOG_DIR={{ fb_receiver_log_dir }}
{% if fb_receiver_tls_enabled | bool %}
TLS_CERT={{ fb_receiver_tls_dir }}/server.crt
TLS_KEY={{ fb_receiver_tls_dir }}/server.key
{% if fb_receiver_mtls | bool %}
TLS_CLIENT_CA={{ fb_receiver_tls_dir }}/client-ca.crt
{% endif %}
{% endif %}
